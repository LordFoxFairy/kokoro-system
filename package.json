{
  "name": "@kokoro/system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check src test scripts *.json *.js *.yaml",
    "lint": "eslint src test scripts",
    "test": "vitest run --no-file-parallelism",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run --no-file-parallelism test/integration",
    "test:contract": "vitest run test/contract",
    "test:contract:target": "vitest run test/contract/system-target-contract.test.ts",
    "contract:lint": "redocly lint contract/openapi/system.openapi.json --extends minimal && tsx scripts/verify-openapi-contract.ts",
    "contract:generate": "tsx scripts/generate-system-openapi.ts && tsx scripts/update-system-openapi-provenance.ts",
    "contract:generate:openapi": "pnpm contract:generate",
    "verify:contract-provenance": "tsx scripts/update-system-openapi-provenance.ts --check",
    "contract:check": "pnpm contract:lint && pnpm verify:contract-provenance && pnpm test:contract",
    "db:apply-schema": "tsx scripts/apply-schema.ts",
    "test:schema:fresh": "tsx scripts/verify-system-fresh-schema.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build",
    "verify": "pnpm check && pnpm contract:check && pnpm test && pnpm test:schema:fresh"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "pg": "8.23.0",
    "redis": "6.2.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@redocly/cli": "2.46.1",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
