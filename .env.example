# Copy locally; never commit real credentials. All three distinct tokens are required.
DATABASE_URL=postgresql://USER@localhost/kokoro?schema=system
REDIS_URL=redis://localhost:6379/2
KOKORO_SYSTEM_REDIS_NAMESPACE=kokoro:system
KOKORO_SYSTEM_BFF_SERVICE_TOKEN=REPLACE_WITH_RANDOM_BFF_TOKEN
KOKORO_SYSTEM_AGENT_SERVICE_TOKEN=REPLACE_WITH_RANDOM_AGENT_TOKEN
KOKORO_SYSTEM_ADMIN_SERVICE_TOKEN=REPLACE_WITH_RANDOM_ADMIN_TOKEN
KOKORO_SYSTEM_HOST=127.0.0.1
KOKORO_SYSTEM_PORT=4240
KOKORO_SYSTEM_REQUEST_TIMEOUT_MS=10000
KOKORO_SYSTEM_SHUTDOWN_DEADLINE_MS=10000
KOKORO_SYSTEM_MODEL_HEALTH_MAX_AGE_MS=60000
KOKORO_SYSTEM_MAINTENANCE_INTERVAL_MS=3600000
# Legal/operational hold pauses physical retention, not detection or restore expiry.
KOKORO_SYSTEM_RETENTION_HOLD=false

# Test deployments only; never permits non-loopback HTTP model endpoints.
KOKORO_SYSTEM_ALLOW_LOOPBACK_MODEL_URL=false

# Optional dedicated model administration identity; distinct from all three above.
# KOKORO_SYSTEM_MODEL_MANAGEMENT_SERVICE_TOKEN=REPLACE_WITH_INDEPENDENT_MODEL_MANAGEMENT_TOKEN
# System deployment-only encryption material; never an Agent/provider API-key file.
# KOKORO_SYSTEM_MODEL_KEY_MATERIAL_FILE=/ABSOLUTE/PRIVATE/PATH/model-key-material.json
