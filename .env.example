# kokoro-system local configuration. Keep secrets out of this file.
NODE_ENV=development
KOKORO_SYSTEM_HOST=127.0.0.1
KOKORO_SYSTEM_PORT=4240
KOKORO_SYSTEM_SHUTDOWN_DEADLINE_MS=10000
# Root shared local PostgreSQL/Redis; System owns its database and logical DB 2.
DATABASE_URL=postgresql://kokoro:kokoro@127.0.0.1:55433/kokoro_worker_system
REDIS_URL=redis://127.0.0.1:56380/2
KOKORO_SYSTEM_REDIS_NAMESPACE=kokoro:system
# Optional. When set, System requires web-bff service auth on business routes.
# KOKORO_SYSTEM_BFF_SERVICE_TOKEN=TOKEN
