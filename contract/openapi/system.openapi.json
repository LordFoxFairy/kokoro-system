      },
      "config_envelope": {
        "type": "object",
        "required": ["data", "meta"],
        "properties": { "data": { "$ref": "#/components/schemas/config" }, "meta": { "$ref": "#/components/schemas/meta" } }
      },
      "release_envelope": {
        "type": "object",
        "required": ["data", "meta"],
        "properties": { "data": { "$ref": "#/components/schemas/release" }, "meta": { "$ref": "#/components/schemas/meta" } }
      },
      "site_page": {
