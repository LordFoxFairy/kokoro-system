{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext", "strict": true,
    "noEmit": true, "verbatimModuleSyntax": true, "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true, "noImplicitOverride": true, "noImplicitReturns": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "allowUnreachableCode": false, "allowUnusedLabels": false
  },
  "include": ["src", "test"]
}
